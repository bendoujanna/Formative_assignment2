rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Keep these domains the same as AppConstaants.allowedEmailDomains in the app.
    function hasAllowedDomain() {
      let email = request.auth.token.email.lower();
      return email.matches('.*@alustudent[.]com')
          || email.matches('.*@alueducation[.]com');
    }

    // Signed in, email verified, and an ALU address.
    function isVerified() {
      return isSignedIn()
          && request.auth.token.email_verified == true
          && hasAllowedDomain();
    }

    // Staff are users whose profile document says role == 'staff'.
    function isStaff() {
      return isVerified()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    match /users/{uid} {
      // You can read your own profile. Staff can read any profile.
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());

      // A new profile can only be created for yourself, as a student.
      allow create: if isSignedIn()
          && request.auth.uid == uid
          && hasAllowedDomain()
          && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
          && request.resource.data.role == 'student'
          && request.resource.data.email == request.auth.token.email;

      // You can edit your own profile but never change your own role.
      allow update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // The incidents collection is added in the next step.
  }
}
